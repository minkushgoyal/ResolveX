# ==============================================================================
# RESOLVEX PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to:
#   - `.env.local` for apps/web Next.js management dashboard
#   - `.env` in apps/mobile for Expo React Native mobile application
#
# Obtain these values from your Firebase Project Console:
# https://console.firebase.google.com/ -> Project Settings -> General -> Your apps
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE WEB CLIENT CONFIGURATION (apps/web - Next.js)
# ------------------------------------------------------------------------------
# Create a Web App in Firebase Console and paste the SDK configuration here:
NEXT_PUBLIC_FIREBASE_API_KEY=your_web_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=hokjgxrf
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=resolvex_mobile
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_web_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# 2. FIREBASE MOBILE CLIENT CONFIGURATION (apps/mobile - Expo React Native)
# ------------------------------------------------------------------------------
# Create Android/iOS/Web apps in Firebase Console and supply the client identifiers:
EXPO_PUBLIC_FIREBASE_API_KEY=your_mobile_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=hokjgxrf
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=resolvex_mobile
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_mobile_firebase_app_id

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH CONFIGURATION (OPTIONAL FOR LIVE SOCIAL SIGN-IN)
# ------------------------------------------------------------------------------
# Configure in Firebase Console -> Authentication -> Sign-in method -> Google:
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. SERVER-SIDE & CLOUD FUNCTIONS CONFIGURATION (firebase/functions)
# ------------------------------------------------------------------------------
# For local Firebase Functions emulator or admin scripting:
# Download from Firebase Console -> Project Settings -> Service accounts -> Generate private key
# IMPORTANT: DO NOT COMMIT THIS FILE TO GIT.
# GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json

# ------------------------------------------------------------------------------
# 5. THIRD-PARTY PROVIDERS (OPTIONAL)
# ------------------------------------------------------------------------------
# AI Provider key for auto-triage / suggestion assistant (falls back to local rules if unset):
OPENAI_API_KEY=

# Payment Provider simulation / gateway keys (keep clearly labeled as simulation unless configured):
PAYMENT_PROVIDER=simulation
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
